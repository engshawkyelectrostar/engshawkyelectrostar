# مفتاح الـ API (32+ حرف عشوائي) - نفس اللي بيتحط في n8n
ERP_API_KEY=change-me-to-a-long-random-string
# IPs مسموحة مفصولة بفاصلة (فاضي = الكل). حط IP الـ VPS أو الـ VPN
ERP_API_ALLOWED_IPS=
# أوراكل 11g: لازم thick mode => مسار Oracle Instant Client (19c بيدعم 11.2)
ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_19_21
ORACLE_USER=api_rw
ORACLE_PASSWORD=
ORACLE_DSN=aixhost:1521/ORCL
