# مفتاح الـ API (32+ حرف عشوائي) - نفس اللي بيتحط في n8n
ERP_API_KEY=change-me-to-a-long-random-string
# IPs مسموحة مفصولة بفاصلة (فاضي = الكل). حط IP الـ VPS أو الـ VPN
ERP_API_ALLOWED_IPS=
# PostgreSQL - يوزر الـ API ليه صلاحيات محدودة (انظر sql/002_roles.sql)
DATABASE_URL=postgresql://api_rw:password@localhost:5432/erp
